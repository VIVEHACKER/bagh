# 필수: 32자 이상 무작위 문자열. 전화번호 암호화·조회 해시·답장 링크 서명 키를 여기서 파생한다.
# 바꾸면 기존 암호화 데이터를 읽을 수 없으니 운영에서는 절대 바꾸지 않는다.
APP_SECRET=

# 운영 Postgres. 비우면 내장 Postgres(PGlite)를 web/.data/pglite에 저장한다(개발용).
DATABASE_URL=

# 알림 링크에 쓰는 사이트 주소
PUBLIC_BASE_URL=http://localhost:3000

# 알림톡 답장 링크 유효 시간(분)
REPLY_LINK_TTL_MIN=15

# 발송 어댑터: 지금은 console(개발용)만 있다. 운영에서는 console이면 서버가 시작하지 않는다.
NOTIFIER=console

# 크론(미룬 알림 발송·보관기간 정리) 호출용 비밀값. 비우면 크론 경로가 꺼진다.
CRON_SECRET=

# 개발 화면에 인증번호를 보여 줄지(0/1). 개발 모드 + NOTIFIER=console + localhost 접속일 때만 효과가 있다.
EXPOSE_DEV_OTP=0

# 앱 앞에서 X-Forwarded-For에 값을 덧붙이는 프록시 수(속도 제한용 IP 판별). Vercel에서는 무시된다.
TRUSTED_PROXY_HOPS=1

# 운영에서 메모리 속도 제한기를 허용할지(0/1). 인스턴스가 하나일 때만 1로 둔다. 여러 개면 Redis 등 공유 제한기가 필요하다.
ALLOW_MEMORY_RATE_LIMIT=0

# 알림 비용 가드레일. 넘는 습득자 메시지는 알림 없이 저장한다(약관 화면도 이 값을 보여 준다).
# 태그당 최근 24시간 대화 수, 대화 하나당 알림 수, 주인당 최근 30일 알림 수(주인이 차단한 대화는 빼고 센다)
NOTIFY_PER_TAG_DAILY=5
NOTIFY_PER_THREAD=3
NOTIFY_PER_OWNER_MONTHLY=30
# 처음 보는 번호(가입 전)로 보내는 최근 24시간 인증번호 상한. 넘으면 새 가입만 멈추고 오류 로그(otp.daily_cap_reached)를 남긴다.
# 가입한 주인의 번호는 이 상한과 무관하게 로그인할 수 있다.
OTP_DAILY_CAP=300
